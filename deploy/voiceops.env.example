# InnerOS VoiceOps — producción en servidor .4
# Copiar a: ~/.config/inneros/voiceops.env
# NUNCA commitear el archivo real con secretos.

# --- Home Assistant (OBLIGATORIO para inventario + ejecución real) ---
HASS_URL=http://192.168.1.4:8123
HASS_TOKEN=

# Permitir actuar sobre entidades descubiertas (sigue requiriendo aprobación verbal)
VOICEOPS_HA_ALLOW_DISCOVERED=true

# Bridge telemetría read-only (fallback lectura si token falla)
VOICEOPS_TELEMETRY_BRIDGE_URL=http://127.0.0.1:8875/api/telemetry

# --- Boson Higgs Realtime (voz) ---
BOSON_API_KEY=
BOSON_API_BASE=https://api.boson.ai/v1

# --- Grandstream UCM6104 (telefonía — heredado VoiceOps AssemblyAI) ---
VOICEOPS_TELEPHONY_AMI_HOST=192.168.1.6
VOICEOPS_TELEPHONY_AMI_USERNAME=
VOICEOPS_TELEPHONY_AMI_SECRET=

# --- Servidor web ---
VOICEOPS_HOST=0.0.0.0
PORT=8765
VOICEOPS_LOG_LEVEL=INFO
