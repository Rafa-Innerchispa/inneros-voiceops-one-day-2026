# AssemblyAI
ASSEMBLYAI_API_KEY=

# InnerOS VoiceOps
VOICEOPS_ENV=development
VOICEOPS_DEMO_TENANT=voiceops-demo
VOICEOPS_LOG_LEVEL=INFO

# InnerOS / MCP endpoints must be configured per environment.
# Never commit credentials or production secrets here.
INNEROS_MCP_URL=

# Optional TTS adapter
VOICEOPS_TTS_PROVIDER=local

# Boson Higgs Realtime (server-side only)
BOSON_API_KEY=
BOSON_API_BASE=https://api.boson.ai/v1

# Home Assistant live telemetry + governed actions (execution requires HASS_TOKEN)
HASS_URL=http://192.168.1.4:8123
HASS_TOKEN=

# Fallback: read LIVE HA via .4 runtime when token is not on this host
VOICEOPS_TELEMETRY_BRIDGE_URL=http://192.168.1.4:8875/api/telemetry

# Governed Home Assistant actions (catalog + allowlist)
# Domains VoiceOps may act on after verbal approval:
VOICEOPS_HA_ACTION_DOMAINS=light,switch,button,input_button,climate,fan,cover,lock,scene,script,automation,alarm_control_panel,media_player,valve,vacuum,unifi
# Set true to allow any discovered entity in those domains (still requires approval):
VOICEOPS_HA_ALLOW_DISCOVERED=false
# Catalog: friendly action id -> HA service mapping (merge/override defaults)
# VOICEOPS_HA_ACTIONS_JSON={"restart_wifi_ap_room":{"label":"Reiniciar AP cuarto","domain":"button","service":"press","entity_id":"button.unifi_ap_cuarto_restart"}}
# Telemetry entity map (same pattern as before):
# VOICEOPS_HA_ENTITIES_JSON={"room_ap":"device_tracker.unifi_cuarto"}

# Grandstream AMI read-only
VOICEOPS_TELEPHONY_AMI_HOST=
VOICEOPS_TELEPHONY_AMI_USERNAME=
VOICEOPS_TELEPHONY_AMI_SECRET=

# Local Qwen / AMD5 reasoning
VOICEOPS_AMD5_URL=http://127.0.0.1:18000/v1/chat/completions
VOICEOPS_AMD5_MODEL=QuantTrio/Qwen3-Coder-30B-A3B-Instruct-AWQ

# InsForge evidence mirror (optional)
INNEROS_INSFORGE_ENABLED=false
INSFORGE_API_KEY=
INSFORGE_REST_URL=
INSFORGE_DASHBOARD_URL=

# InstaCloud preview deployment (optional)
INNEROS_INSTACLOUD_ENABLED=false
INSTACLOUD_API_KEY=
INSTACLOUD_PROJECT_ID=voiceops-boson
INSTACLOUD_DEPLOYMENT_ID=voiceops-boson-preview
INSTACLOUD_PREVIEW_URL=
INSTACLOUD_STATUS_URL=
INSTACLOUD_DASHBOARD_URL=
